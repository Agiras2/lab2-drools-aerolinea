package rules;

import com.udea.aerolinea.model.Passenger;
import com.udea.aerolinea.model.Flight;
import com.udea.aerolinea.model.BenefitsResponse;

// Regla 1: Ascenso a clase ejecutiva para viajeros frecuentes con retrasos
rule "UpgradeToBusinessClassForFrequentFlyersWithDelays"
    when
        $p : Passenger(membership == "Gold" || membership == "Platinum")
        $f : Flight(delayMinutes > 60)
        $r : BenefitsResponse()
    then
        $r.setBusinessUpgrade(true);
        $r.addRule("UpgradeToBusinessClassForFrequentFlyersWithDelays: ascenso a clase ejecutiva por viajero frecuente (Gold/Platinum) con vuelo retrasado mas de 60 minutos.");
end

// Regla 2: Check-in prioritario para adultos mayores
rule "PriorityCheckInForSeniors"
    when
        $p : Passenger(age > 65)
        $r : BenefitsResponse()
    then
        $r.setPriorityCheckIn(true);
        $r.addRule("PriorityCheckInForSeniors: check-in prioritario para pasajero mayor de 65 anios.");
end

// Regla 3: Descuento por equipaje ligero
rule "DiscountForLightLuggage"
    when
        $p : Passenger(luggageWeight < 10)
        $r : BenefitsResponse()
    then
        $r.setDiscountPercent(10.0);
        $r.addRule("DiscountForLightLuggage: descuento del 10% por equipaje menor a 10 kg.");
end

// Regla 4: Denegar ascenso por equipaje con sobrepeso
rule "DenyUpgradeForOverweightLuggage"
    when
        $p : Passenger(luggageWeight > 23)
        $r : BenefitsResponse()
    then
        $r.setEligibleForUpgrade(false);
        $r.addRule("DenyUpgradeForOverweightLuggage: no elegible para ascensos por equipaje mayor a 23 kg.");
end

// Regla 5: Asignar asiento de salida de emergencia a adultos jovenes
rule "AssignEmergencyExitSeatToYoungAdults"
    when
        $p : Passenger(age >= 18 && age <= 40, seatPreference == "Any")
        $f : Flight(emergencyExitSeatAvailable == true)
        $r : BenefitsResponse()
    then
        $r.setEmergencyExitSeatAssigned(true);
        $r.setAssignedSeat("Asiento de salida de emergencia");
        modify($f) { setEmergencyExitSeatAvailable(false) }
        $r.addRule("AssignEmergencyExitSeatToYoungAdults: asignado asiento de salida de emergencia y marcado como ocupado.");
end

// Regla 6: Compensacion por retrasos extremos
rule "CompensationForExtremeDelays"
    when
        $f : Flight(delayMinutes > 180)
        $r : BenefitsResponse()
    then
        $r.setCompensation(200.0);
        $r.addRule("CompensationForExtremeDelays: compensacion de $200 por retraso mayor a 180 minutos.");
end

// Regla 7: Puntos de lealtad extra para vuelos largos
rule "ExtraLoyaltyPointsForLongFlights"
    when
        $p : Passenger(membership != "Basic")
        $f : Flight(durationHours > 5)
        $r : BenefitsResponse()
    then
        $r.setLoyaltyPointsAdded($r.getLoyaltyPointsAdded() + 500);
        $r.addRule("ExtraLoyaltyPointsForLongFlights: +500 puntos de lealtad por vuelo de mas de 5 horas.");
end

// Regla 8: Restringir equipaje en vuelos cortos
rule "RestrictLuggageOnShortFlights"
    when
        $p : Passenger(luggageWeight > 15)
        $f : Flight(durationHours < 2)
        $r : BenefitsResponse()
    then
        $r.setLuggageAllowed(false);
        $r.addRule("RestrictLuggageOnShortFlights: equipaje no permitido (mayor a 15 kg en vuelo de menos de 2 horas).");
end

// Regla 9: Acceso al salon VIP para miembros Platinum
rule "VipLoungeAccessForPlatinumMembers"
    when
        $p : Passenger(membership == "Platinum")
        $r : BenefitsResponse()
    then
        $r.setVipLoungeAccess(true);
        $r.addRule("VipLoungeAccessForPlatinumMembers: acceso al salon VIP para miembros Platinum.");
end

// Regla 10: Asiento preferencial para familias
rule "PreferentialSeatForFamilies"
    when
        $p : Passenger(travelingWithChildren == true, seatPreference == "Any")
        $r : BenefitsResponse()
    then
        $r.setAssignedSeat("Asiento preferencial para familias");
        $r.addRule("PreferentialSeatForFamilies: asignado asiento preferencial para familias.");
end